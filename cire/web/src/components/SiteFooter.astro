---
// Site-wide footer. Links to the legal pages so the privacy notice + terms are
// reachable from every page (compliance blocker C-H4: privacy notice must be
// published and linked at point of collection).
//
// It also carries the standing "Privacy choices" control. Consent has to be as
// easy to withdraw as it was to give, and the banner is by definition gone once
// a guest has decided — so a permanent, findable entry point into the
// preferences dialog is what makes the earlier "you can change this later"
// promise true. The footer is the one component every document shell already
// renders, which makes it the right home.
import { ConsentPreferencesLink } from './consent/ConsentBanner'
import { hasFooterMessage } from './invite-emptiness'
import { cropAspectRatio, cropBackgroundStyle, type ImageCrop } from './image-crop'
import { buildSrcSet, variantSrc } from './invite-images'

// The footer image's default display shape when no crop was saved (or a legacy
// crop carries no source dims). Square: the slot is sized for a monogram, motif
// or signature rather than a scene, and a square reads as deliberate at the
// small width the footer gives it.
const FOOTER_IMAGE_ASPECT = 1

interface Props {
  /**
   * Closing line for the invite — the couple's title. Given, the footer signs
   * off in their name before the legal links, so the invitation ends on the
   * people it is from rather than on the word "Terms". Absent (legal pages,
   * 404) ⇒ links only.
   */
  closing?: string | null
  /**
   * The couple's optional closing note, set in the invite builder ("Looking
   * forward to celebrating with you", "No boxed gifts please"). It sits above
   * the couple's name, so the sign-off still reads last.
   *
   * Like the other optional invite segments this has NO built-in default: blank
   * or whitespace-only ⇒ nothing renders (checked with the shared
   * `hasFooterMessage` predicate, so the organiser builder's "Shown / Hidden —
   * empty" badge and this render can't disagree).
   */
  message?: string | null
  /**
   * The couple's optional footer image — a monogram, motif or signature above
   * the note. An ABSOLUTE URL (the caller prepends the API origin, as it does
   * for the hero preload), or null/absent for no image.
   *
   * Independent of `message`: either alone renders, and neither ⇒ the footer is
   * exactly what it has always been (couple's title over the legal links).
   */
  imageUrl?: string | null
  /** Crop rectangle the organiser framed the footer image with, if any. */
  imageCrop?: ImageCrop | null
}

const { closing, message, imageUrl, imageCrop } = Astro.props

const showMessage = hasFooterMessage(message)

// When a crop was saved, render the cropped region with the same CSS-fraction
// technique the story photo uses (a background layer — backgrounds can't take a
// srcset, so we ask for one bounded variant comfortably above the rendered
// width at retina). With no crop, fall back to a plain responsive <img>.
const cropStyle = imageUrl ? cropBackgroundStyle(variantSrc(imageUrl, 'card'), imageCrop) : null
// The box adopts the crop's TRUE pixel aspect (from its captured source dims) so
// the uniformly-scaled region fills it with no distortion and no empty bars; a
// legacy crop with no dims falls back to the slot's square default.
const imageAspect = String(cropAspectRatio(imageCrop, FOOTER_IMAGE_ASPECT))
---
<footer class="site-footer">
  {
    imageUrl && (
      <div class="motif">
        {cropStyle ? (
          <div
            aria-hidden="true"
            class="motif-img motif-crop"
            style={{ ...cropStyle, 'aspect-ratio': imageAspect }}
          />
        ) : (
          /* Renders at most 200px wide — `thumb` (320w) covers it at 2× DPR. */
          <img
            src={imageUrl}
            srcset={buildSrcSet(imageUrl, ['thumb'])}
            sizes="200px"
            alt=""
            class="motif-img"
            style={{ 'aspect-ratio': imageAspect }}
          />
        )}
      </div>
    )
  }
  {showMessage && <p class="note">{message}</p>}
  {closing && <p class="closing">{closing}</p>}
  <nav aria-label="Legal">
    <a href="/privacy">Privacy Notice</a>
    <span aria-hidden="true">&middot;</span>
    <a href="/terms">Terms</a>
    <span aria-hidden="true">&middot;</span>
    <ConsentPreferencesLink client:idle label="Privacy Choices" class="consent-link" />
  </nav>
</footer>

<style>
  .site-footer {
    padding: 2rem 1.5rem 2.5rem;
    text-align: center;
    font-family: var(--font-body, "Lato", system-ui, sans-serif);
    font-size: 0.8125rem;
    color: var(--color-text-muted, rgba(255, 255, 255, 0.5));
  }

  /* The couple's footer image — a monogram, motif or signature, not a scene.
     Deliberately small and centred: it opens the sign-off block above the note
     and the names, so it has to read as a flourish rather than compete with the
     hero. Width-capped and viewport-relative so it stays proportionate on a
     phone, where 200px would be half the screen. */
  .site-footer .motif {
    display: flex;
    justify-content: center;
    margin: 0 0 1.25rem;
  }

  .site-footer .motif-img {
    width: min(200px, 45vw);
    height: auto;
    /* An uncropped upload gets the square default; a cropped one gets its own
       aspect from the inline style. `cover` only matters on the <img> path —
       the crop path paints a sized background layer instead. */
    object-fit: cover;
    border-radius: 2px;
  }

  /* The cropped variant paints a background layer, so the box must clip it and
     carry its own size (an empty div has no intrinsic dimensions). */
  .site-footer .motif-crop {
    overflow: hidden;
    background-repeat: no-repeat;
  }

  /* The couple's closing note. Body font (it is a sentence, not a name) and
     measure-capped so a longer note wraps to readable lines rather than one
     wide band on desktop. Sits a little larger than the legal row so it reads
     as part of the invitation. */
  .site-footer .note {
    margin: 0 auto 1rem;
    max-width: 34rem;
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    line-height: 1.6;
    font-style: italic;
    /* Deliberately not the muted legal grey — this is the couple speaking. */
    color: var(--color-text, rgba(255, 255, 255, 0.82));
    /* An organiser may type a multi-line note; honour the breaks they chose
       without letting a long single line overflow on a phone. */
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .site-footer .closing {
    margin: 0 0 1.25rem;
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 300;
    line-height: 1.2;
    /* pb reserve: a descender in a name (Jyoti, Peggy) must keep its tail. */
    padding-bottom: 0.15em;
    color: var(--color-gold, oklch(74.99% 0.0854 82.08));
  }

  .site-footer nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--color-gold, oklch(74.99% 0.0854 82.08));
    border-bottom-color: currentColor;
  }

  /* The consent control is a <button> (it opens a dialog rather than navigating)
     rendered by a Solid island, so it needs `:global` to be reached from this
     scoped block — Astro's scope attribute is only stamped on markup in this
     template, not on DOM the island creates at hydration. It is styled to sit
     in the row as a peer of the two legal links: the guest should not have to
     recognise a different affordance to find their privacy choices. */
  .site-footer :global(.consent-link) {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .site-footer :global(.consent-link:hover),
  .site-footer :global(.consent-link:focus-visible) {
    color: var(--color-gold, oklch(74.99% 0.0854 82.08));
    border-bottom-color: currentColor;
  }

  /* Keep the island from introducing a line box of its own inside the flex row. */
  .site-footer nav :global(astro-island) {
    display: contents;
  }
</style>
